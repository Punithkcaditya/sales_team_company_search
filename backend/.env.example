# Copy this file to .env and fill in both keys.
# Leave them blank to run in demo mode (canned data, no network calls) --
# the app still works end to end.

# The model. Free tier, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Google search results as JSON. 2,500 free queries, no credit card:
# https://serper.dev/api-key
SERPER_API_KEY=

# --- Optional overrides ------------------------------------------------------
# Research runs on one model and the briefing is written by a faster one.
# Set them equal to use a single model.
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_WRITER_MODEL=gemini-flash-lite-latest

# "auto" runs live research when both keys are present; "demo" forces the
# canned agent regardless.
# LLM_PROVIDER=auto

# A guard on this app's own usage, so a day's clicking cannot exhaust the
# provider's free allowance. It is not a spending limit -- the free tier
# cannot be billed. Set to 0 to remove it.
# DAILY_RESEARCH_LIMIT=50

# DATABASE_PATH=reports.db
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
