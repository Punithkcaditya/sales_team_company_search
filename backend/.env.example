# Copy to .env and fill in. Leave everything blank to run in demo mode (canned
# data, no network calls) -- the app still works end to end.

# --- Recommended: Gemini -----------------------------------------------------
# One key, and that's it: Google Search is built into the model, so there is no
# separate search API to sign up for. Free tier, no billing account required.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_PROVIDER=gemini
# --- Alternative: Claude + Serper --------------------------------------------
# Needs two keys, and both are paid past their free allowances.
# ANTHROPIC_API_KEY=          # https://console.anthropic.com/settings/keys
# SERPER_API_KEY=             # https://serper.dev/api-key
# ANTHROPIC_MODEL=claude-opus-5

# --- Overrides ---------------------------------------------------------------
# Which provider to use. "auto" (the default) picks whichever keys are present,
# preferring Gemini. Set to gemini | anthropic | demo to pin one.
# LLM_PROVIDER=auto
# DATABASE_PATH=reports.db
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
